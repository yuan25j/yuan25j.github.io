---
import { navLinks } from "../data/nav";
import EmailAction from "./EmailAction.astro";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="wordmark" href="/" aria-label="John Yuan, home">JY<span>.</span></a>
      <p>Software Engineer at Wells Fargo.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="footer-links">
      <EmailAction label="Email" />
      <a href="https://github.com/yuan25j" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/john-yuan-867686204/" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </div>
  <div class="shell footer-note">
    <span>© {new Date().getFullYear()} John Yuan</span>
    <span>Built with Astro · Designed for the web</span>
  </div>
</footer>
