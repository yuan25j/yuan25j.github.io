---
interface Props {
  kind: "languages" | "data" | "frontend" | "backend" | "cloud" | "work" | "education" | "location" | "contact";
}

const { kind } = Astro.props;
---

<svg class="category-graphic" viewBox="0 0 48 48" aria-hidden="true">
  {kind === "languages" && <path d="m17 14-9 10 9 10M31 14l9 10-9 10M28 8l-8 32" />}
  {kind === "data" && <><ellipse cx="24" cy="12" rx="14" ry="6" /><path d="M10 12v12c0 3 6 6 14 6s14-3 14-6V12M10 24v12c0 3 6 6 14 6s14-3 14-6V24" /></>}
  {kind === "frontend" && <><rect x="6" y="9" width="36" height="28" rx="3" /><path d="M6 17h36M15 42h18M24 37v5" /></>}
  {kind === "backend" && <><rect x="8" y="7" width="32" height="12" rx="3" /><rect x="8" y="29" width="32" height="12" rx="3" /><path d="M15 13h1M15 35h1M32 19v10" /></>}
  {kind === "cloud" && <path d="M14 37h23a8 8 0 0 0 1-16 14 14 0 0 0-27-2 9 9 0 0 0 3 18Z" />}
  {kind === "work" && <><rect x="7" y="14" width="34" height="26" rx="4" /><path d="M17 14V9h14v5M7 25h34M20 25v4h8v-4" /></>}
  {kind === "education" && <><path d="m4 19 20-10 20 10-20 10L4 19Z" /><path d="M12 23v10c8 7 16 7 24 0V23M44 19v15" /></>}
  {kind === "location" && <><path d="M38 20c0 11-14 23-14 23S10 31 10 20a14 14 0 1 1 28 0Z" /><circle cx="24" cy="20" r="5" /></>}
  {kind === "contact" && <><rect x="5" y="10" width="38" height="28" rx="4" /><path d="m7 13 17 14 17-14M7 36l12-13M41 36 29 23" /></>}
</svg>
