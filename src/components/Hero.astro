---
import EmailAction from "./EmailAction.astro";
---

<section class="hero shell">
  <div class="hero-copy">
    <p class="eyebrow" data-reveal style="--reveal-delay: 40ms"><span class="status-dot"></span> Software Engineer · Wells Fargo</p>
    <h1 data-reveal style="--reveal-delay: 110ms">John <em>Yuan.</em></h1>
    <p class="lede" data-reveal style="--reveal-delay: 180ms">
      Software engineer working in data engineering, data governance, and full-stack development
      with Python, SQL, React, and Java.
    </p>
    <div class="button-row" data-reveal style="--reveal-delay: 250ms">
      <a class="button primary" href="/work/">View experience <span aria-hidden="true">↗</span></a>
      <EmailAction class="button secondary" label="Email me" />
    </div>
  </div>
  <aside class="hero-card" aria-label="Current focus" data-reveal data-pointer-surface style="--reveal-delay: 180ms">
    <div class="hero-card-top">
      <span>Currently</span>
      <span class="availability">2026</span>
    </div>
    <strong>ETL, governance, and full-stack systems.</strong>
    <ul class="hero-facts">
      <li><span>Role</span><b>Software Engineer, Wells Fargo</b></li>
      <li><span>Based</span><b>Charlotte, NC</b></li>
      <li><span>Stack</span><b>Python · SQL · React · Java</b></li>
    </ul>
  </aside>
</section>
