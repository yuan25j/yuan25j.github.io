    {variant === "equipment" && (
      <g>
        <path class="graphic-line draw-line" d="M45 49h252v145H45zM129 49v145M213 49v145M45 121h252" />
        <rect class="graphic-fill graphic-node" x="65" y="70" width="44" height="29" rx="5" />
        <circle class="graphic-fill-soft graphic-node" cx="171" cy="84" r="19" />
        <path class="graphic-fill graphic-node" d="M238 71h36v27h-36zM72 145h30v27H72z" />
