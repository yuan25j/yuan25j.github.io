      </g>
    )}

    {variant === "travel" && (
      <g>
        <rect class="graphic-paper graphic-node" x="36" y="36" width="250" height="168" rx="16" />
        <path class="graphic-line" d="M36 92h250M36 148h250M120 36v168M204 36v168" />
