        <text class="graphic-ink-label" x="240" y="126">API</text>
        <path class="graphic-line draw-line" d="M293 120h70" />
        <ellipse class="graphic-paper graphic-node" cx="402" cy="89" rx="38" ry="16" />
        <path class="graphic-line" d="M364 89v61c0 9 17 16 38 16s38-7 38-16V89M364 120c0 9 17 16 38 16s38-7 38-16" />
      </g>
