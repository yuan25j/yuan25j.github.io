    {variant === "akari" && (
      <g>
        <path class="graphic-line draw-line" d="M120 30v180M180 30v180M240 30v180M300 30v180M360 30v180M60 70h360M60 110h360M60 150h360M60 190h360" />
        <rect class="graphic-fill-soft graphic-node" x="121" y="71" width="58" height="38" />
        <rect class="graphic-fill-soft graphic-node" x="301" y="151" width="58" height="38" />
