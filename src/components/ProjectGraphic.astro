---
interface Props {
  id: string;
  compact?: boolean;
}

const { id, compact = false } = Astro.props;
const variant =
  id.includes("course-scheduler") ? "scheduler" :
  id.includes("fingerprinting") ? "fingerprint" :
  id.includes("llm-vs") ? "comparison" :
  id.includes("rag-") ? "rag" :
  id.includes("equipment") ? "equipment" :
  id.includes("registration") ? "registration" :
  id.includes("akari") ? "akari" :
  id.includes("travel") ? "travel" :
  id.includes("weather") ? "weather" : "code";
---

<div class:list={["project-graphic", { compact }]} data-graphic data-variant={variant} aria-hidden="true">
  <svg viewBox="0 0 480 240" role="presentation">
    <rect class="graphic-frame" x="1" y="1" width="478" height="238" rx="18" />

    {variant === "scheduler" && (
      <g>
        <path class="graphic-line draw-line" d="M48 55h270v144H48zM48 91h270M102 55v144M156 55v144M210 55v144M264 55v144" />
        <rect class="graphic-fill graphic-node" x="109" y="101" width="40" height="26" rx="5" />
        <rect class="graphic-fill-soft graphic-node" x="217" y="136" width="40" height="46" rx="5" />
        <rect class="graphic-fill graphic-node" x="55" y="138" width="40" height="25" rx="5" />
        <circle class="graphic-accent graphic-node" cx="391" cy="88" r="28" />
        <path class="graphic-line draw-line" d="M318 112c31 0 34-24 45-24M318 165c43 0 48-53 58-59M391 116v54" />
        <path class="graphic-line" d="m378 169 13 13 24-31" />
      </g>
    )}

    {variant === "fingerprint" && (
      <g transform="translate(45 16)">
        <path class="graphic-line draw-line" d="M195 188c-52-20-76-55-76-98 0-39 32-70 72-70 41 0 75 31 75 72 0 67-34 107-64 128" />
        <path class="graphic-line draw-line" d="M195 168c-35-17-51-41-51-75 0-28 21-49 48-49 29 0 51 21 51 50 0 50-25 83-48 101" />
        <path class="graphic-line draw-line" d="M194 140c-18-12-26-26-26-46 0-14 10-25 24-25 15 0 26 11 26 27 0 28-11 49-25 64" />
        <circle class="graphic-accent graphic-node" cx="194" cy="95" r="9" />
        <path class="graphic-line draw-line" d="M292 57h91M292 89h64M292 121h79M292 153h48" />
        <circle class="graphic-fill graphic-node" cx="394" cy="57" r="7" />
        <circle class="graphic-fill-soft graphic-node" cx="367" cy="89" r="7" />
        <circle class="graphic-fill graphic-node" cx="382" cy="121" r="7" />
      </g>
    )}

    {variant === "comparison" && (
      <g>
        <text class="graphic-label" x="44" y="72">LLM</text>
        <text class="graphic-label" x="44" y="169">ML</text>
        <path class="graphic-line draw-line" d="M98 66h320M98 163h320" />
        {[142, 220, 298, 376].map((x, index) => (
          <g>
            <circle class:list={["graphic-node", index % 2 ? "graphic-fill-soft" : "graphic-fill"]} cx={x} cy="66" r="15" />
            <circle class:list={["graphic-node", index % 2 ? "graphic-fill" : "graphic-fill-soft"]} cx={x} cy="163" r="15" />
          </g>
        ))}
        <path class="graphic-accent-line draw-line" d="M111 114h294" />
        <text class="graphic-small-label" x="210" y="105">SAME EVALUATION</text>
      </g>
    )}

    {variant === "rag" && (
      <g>
        <rect class="graphic-paper graphic-node" x="39" y="61" width="75" height="98" rx="8" />
