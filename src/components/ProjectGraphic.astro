        <circle class="graphic-fill graphic-node" cx="318" cy="58" r="7" />
        <circle class="graphic-accent graphic-node" cx="318" cy="98" r="7" />
        <circle class="graphic-fill-soft graphic-node" cx="318" cy="138" r="7" />
        <circle class="graphic-accent graphic-node" cx="318" cy="178" r="7" />
        <path class="graphic-line draw-line" d="M338 58h98M338 98h78M338 138h92M338 178h64" />
