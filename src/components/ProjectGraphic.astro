        <path class="graphic-line draw-line" d="M78 210v18M130 210v18M182 210v18" />
      </g>
    )}

    {variant === "code" && (
      <g>
        <rect class="graphic-paper graphic-node" x="47" y="38" width="386" height="164" rx="14" />
        <path class="graphic-line" d="M47 72h386" />
        <circle class="graphic-fill" cx="70" cy="55" r="5" />
        <circle class="graphic-fill-soft" cx="88" cy="55" r="5" />
        <circle class="graphic-accent" cx="106" cy="55" r="5" />
        <path class="graphic-accent-line draw-line" d="m91 108-19 15 19 15M125 145l24-50M183 108l19 15-19 15" />
        <path class="graphic-line draw-line" d="M236 106h142M236 130h108M236 154h126" />
      </g>
    )}
  </svg>
</div>
