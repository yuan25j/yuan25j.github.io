---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyFrame from "../../components/CaseStudyFrame.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";
import LiveDemo from "../../components/LiveDemo.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("projects"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: entries[index - 1],
      next: entries[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
  prev?: CollectionEntry<"projects">;
  next?: CollectionEntry<"projects">;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const liveDemo = entry.data.demo?.includes("streamlit.app") ? entry.data.demo : undefined;
const meta = [
  { label: "Year", value: String(entry.data.date.getUTCFullYear()) },
  { label: "Stack", value: entry.data.skills.slice(0, 3).join(", ") },
  ...(entry.data.github ? [{ label: "Source", value: "GitHub ↗", href: entry.data.github }] : []),
  ...(entry.data.demo ? [{ label: "Demo", value: liveDemo ? "Open app ↗" : "Watch ↗", href: entry.data.demo }] : []),
];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <CaseStudyFrame
    backHref="/projects/"
    backLabel="← All projects"
    eyebrow={entry.data.skills.slice(0, 3).join(" · ")}
    title={entry.data.title}
    lede={entry.data.description}
    meta={meta}
    tags={entry.data.skills}
    prev={prev ? { href: `/projects/${prev.id}/`, label: prev.data.title, kicker: prev.data.category === "research" ? "Previous research" : "Previous software" } : undefined}
    next={next ? { href: `/projects/${next.id}/`, label: next.data.title, kicker: next.data.category === "research" ? "Next research" : "Next software" } : undefined}
  >
    <div class="case-visual shell" slot="visual" data-reveal>
      {liveDemo ? <LiveDemo url={liveDemo} title={entry.data.title} /> : <ProjectPreview id={entry.id} />}
    </div>
    <p class="eyebrow">The problem</p>
    <h2>{entry.data.problem}</h2>
    <Content />
    <h2>Outcome</h2>
    <p>{entry.data.outcome}</p>
  </CaseStudyFrame>
</BaseLayout>
