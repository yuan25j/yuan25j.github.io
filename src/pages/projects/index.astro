---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProcessGraphic from "../../components/ProcessGraphic.astro";
import ContactBand from "../../components/ContactBand.astro";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const researchProjects = projects.filter((project) => project.data.category === "research");
const softwareProjects = projects.filter((project) => project.data.category === "software");
---

<BaseLayout title="Projects" description="Research and software projects by John Yuan.">
  <PageHero
    eyebrow="Research · Software"
    title="Projects."
    lede="Research work in machine learning and LLMs, plus selected software projects."
    layout="split"
  >
    <ProcessGraphic kind="research" />
    <nav class="category-chips" slot="actions" aria-label="Project categories">
      <a href="#research">Research ({researchProjects.length})</a>
      <a href="#software">Software ({softwareProjects.length})</a>
    </nav>
  </PageHero>

  <section class="section shell" id="research">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Research</p>
        <h2>Research projects.</h2>
      </div>
      <p>Technical research involving language models, NLP, retrieval-augmented generation, and machine learning.</p>
    </div>
    <div class="project-grid">
      {researchProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="section shell" id="software">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Development</p>
        <h2>Software projects.</h2>
      </div>
      <p>Full-stack applications, APIs, and desktop software.</p>
    </div>
    <div class="project-grid">
      {softwareProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <ContactBand />
</BaseLayout>
