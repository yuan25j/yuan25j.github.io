---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="page-hero shell" data-reveal>
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p class="lede">The requested page does not exist or may have moved.</p>
    <div class="button-row">
      <a class="button primary" href="/">Back home</a>
      <a class="button secondary" href="/projects/">Browse projects</a>
    </div>
  </section>
</BaseLayout>
