---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Timeline from "../components/Timeline.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import Skills from "../components/Skills.astro";
import ProcessGraphic from "../components/ProcessGraphic.astro";
import ContactBand from "../components/ContactBand.astro";

const work = (await getCollection("work"))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
const allProjects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const highlightedIds = ["autonomous-ai-travel-agent", "unc-course-scheduler"];
const highlightedProjects = highlightedIds
  .map((id) => allProjects.find((project) => project.id === id))
  .filter((project) => project !== undefined);
const projects = allProjects
  .filter((project) => project.data.featured && !highlightedIds.includes(project.id));
---

<BaseLayout>
  <Hero />

  <section class="section shell" aria-labelledby="featured-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="featured-title">Featured projects.</h2>
      </div>
      <p>A natural-language travel planner and a course scheduler built with integer linear programming.</p>
    </div>
    <div class="bento">
      {highlightedProjects.map((project, index) => (
        <a
          class="bento-panel featured-project"
          href={`/projects/${project.id}/`}
          data-reveal
          data-pointer-surface
          style={`--reveal-delay: ${index * 70}ms`}
        >
          <p class="eyebrow">{project.data.category === "research" ? "Research" : "Software"}</p>
          <h3>{project.data.title}</h3>
          <ProjectPreview id={project.id} compact />
          <p class="muted">{project.data.description}</p>
          <span class="back-link">View case study ↗</span>
        </a>
      ))}
      <article class="bento-panel wide" data-reveal style="--reveal-delay: 120ms">
        <p class="eyebrow">Current areas of work</p>
        <h3>Data engineering, governance, and full-stack development</h3>
        <ProcessGraphic kind="stack" />
        <p class="lede">Python and SQL ETL processes alongside a React and Java application built with Gradle.</p>
      </article>
    </div>
  </section>

  <section class="section shell" aria-labelledby="work-title">
    <div class="section-head" data-reveal>
      <div><p class="eyebrow">Experience</p><h2 id="work-title">Professional experience.</h2></div>
      <a class="back-link" href="/work/">Full timeline ↗</a>
    </div>
    <Timeline entries={work.slice(0, 3)} compact />
  </section>

  <section class="section shell" aria-labelledby="projects-title">
    <div class="section-head" data-reveal>
      <div><p class="eyebrow">Additional work</p><h2 id="projects-title">More projects.</h2></div>
      <a class="back-link" href="/projects/">All projects ↗</a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="skills-title">
    <div class="section-head" data-reveal>
      <div><p class="eyebrow">Technical skills</p><h2 id="skills-title">Skills and technologies.</h2></div>
      <p>Languages, frameworks, data tools, and cloud services I have used.</p>
    </div>
    <Skills />
  </section>

  <ContactBand />
</BaseLayout>
