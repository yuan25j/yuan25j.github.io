---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompanyLogo from "../../components/CompanyLogo.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"work">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const formatter = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const dates = `${formatter.format(entry.data.startDate)} — ${
  entry.data.endDate === "Present" ? "Present" : formatter.format(entry.data.endDate)
}`;
---

<BaseLayout title={`${entry.data.title} at ${entry.data.company}`} description={entry.data.summary}>
  <header class="page-hero shell case-header" data-reveal>
    <div>
      <a class="back-link" href="/work/">← All experience</a>
      <CompanyLogo company={entry.data.company} large />
      <p class="eyebrow">{entry.data.company}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </div>
    <dl class="case-meta">
      <div><dt>Company</dt><dd>{entry.data.company}</dd></div>
      <div><dt>Period</dt><dd>{dates}</dd></div>
      {entry.data.location && <div><dt>Location</dt><dd>{entry.data.location}</dd></div>}
      <div><dt>Focus</dt><dd>{entry.data.skills.slice(0, 3).join(", ")}</dd></div>
    </dl>
  </header>
  <article class="section narrow prose" data-reveal>
    <Content />
    <h2>Selected impact</h2>
    <ul>{entry.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    <div class="tags">{entry.data.skills.map((skill) => <span>{skill}</span>)}</div>
  </article>
</BaseLayout>
