---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyFrame from "../../components/CaseStudyFrame.astro";
import CompanyLogo from "../../components/CompanyLogo.astro";
import ProcessGraphic from "../../components/ProcessGraphic.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("work"))
    .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: entries[index - 1],
      next: entries[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
  prev?: CollectionEntry<"work">;
  next?: CollectionEntry<"work">;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const formatter = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const dates = `${formatter.format(entry.data.startDate)} — ${
  entry.data.endDate === "Present" ? "Present" : formatter.format(entry.data.endDate)
}`;
const skills = entry.data.skills.join(" ").toLowerCase();
const processKind = skills.includes("etl") || skills.includes("governance")
  ? "etl"
  : skills.includes("lambda") || skills.includes("ci/cd")
    ? "delivery"
    : skills.includes("react") || skills.includes("java") || skills.includes("angular")
      ? "stack"
      : undefined;
const meta = [
  { label: "Company", value: entry.data.company },
  { label: "Period", value: dates },
  ...(entry.data.location ? [{ label: "Location", value: entry.data.location }] : []),
  { label: "Focus", value: entry.data.skills.slice(0, 3).join(", ") },
];
---

<BaseLayout title={`${entry.data.title} at ${entry.data.company}`} description={entry.data.summary}>
  <CaseStudyFrame
    backHref="/work/"
    backLabel="← All experience"
    eyebrow={entry.data.company}
    title={entry.data.title}
    lede={entry.data.summary}
    meta={meta}
    tags={entry.data.skills}
    prev={prev ? { href: `/work/${prev.id}/`, label: prev.data.title, kicker: prev.data.company } : undefined}
    next={next ? { href: `/work/${next.id}/`, label: next.data.title, kicker: next.data.company } : undefined}
  >
    <CompanyLogo slot="lead-visual" company={entry.data.company} large />
    {processKind && (
      <div class="case-visual shell" slot="visual" data-reveal>
        <ProcessGraphic kind={processKind} />
      </div>
    )}
    <Content />
    <h2>Selected impact</h2>
    <ul>{entry.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
  </CaseStudyFrame>
</BaseLayout>
